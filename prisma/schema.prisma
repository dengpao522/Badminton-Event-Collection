// ============================================================
// 「全民运动」赛事聚合站 MVP 数据模型
// 设计依据：docs/PRD 第五章，字段与现有赛事清单 Excel 对齐
// 说明：MVP 使用 SQLite 本地文件（Prisma 在 SQLite 不支持 enum，
//       故状态类字段用 String，取值在 src/lib/constants.ts 中统一定义；
//       将来迁 PostgreSQL 时可平滑收敛为 enum）
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- 赛事主表 ----------
model Event {
  id    String @id @default(cuid())
  // 赛事官方名称（含规模/俗称）
  name  String
  // 城市：MVP 仅 上海 / 杭州
  city  String
  province String @default("")

  // 一级品类（跑步/球类/户外/骑行/水上/冰雪/室内健身/棋牌智力/其他综合）
  category String
  // 二级标签（JSON 数组字符串，如 ["半马","元旦"]），保留 Excel 原始品类写法
  tags     String @default("[]")

  // 日期：raceDateText 为 Excel 原文（如“11月7日（周六）”“待核实”），保证不丢信息
  raceDateText  String
  // 尽力解析出的日期，用于排序与状态自动推进；无法解析为 null
  raceDateStart DateTime?
  raceDateEnd   DateTime?
  // 具体地点原文（如“虹口·北外滩国客中心码头”）
  venue String @default("")

  // 报名状态，取值见 src/lib/constants.ts 的 REG_STATUS（默认待核实）
  status String @default("UNVERIFIED")
  // 报名截止原文与解析时间
  deadlineText String @default("")
  deadlineAt   DateTime?

  // 报名指引（渠道+操作步骤原文）与可点击外链（若能提取）
  registerGuide String @default("")
  registerUrl   String @default("")

  // 信息可信度：VERIFIED / UNVERIFIED
  verifyStatus String @default("UNVERIFIED")
  verifiedAt   DateTime?
  sourceName   String @default("")
  sourceUrl    String @default("")

  // 赛事性质：PARTICIPATABLE 可报名 / VIEWING 仅观赛 / REFERENCE 历史参考
  kind String @default("PARTICIPATABLE")
  // 数据来源类型：MANUAL_COLLECTION 运营采集 / USER_SUBMISSION 用户投稿
  dataOrigin String @default("MANUAL_COLLECTION")
  // 来源工作表名（导入溯源）
  sourceSheet String @default("")

  isPublished Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  // 球馆发布者：运营采集的赛事为 null；球馆发布的记录提交用户（审核通过后上架）
  submittedByUserId String?
  submittedBy       User?   @relation(fields: [submittedByUserId], references: [id], onDelete: SetNull)
  // 社区讨论区：关联赛事的帖子（赛事详情页「赛事讨论」数据源）
  discussionPosts Post[]

  @@index([city, category, status])
  @@index([raceDateStart])
}

// ---------- 邮箱提醒订阅（P0 免注册）----------
model Subscription {
  id    String @id @default(cuid())
  email String
  // 提醒类型，取值见 src/lib/constants.ts 的 SUB_TYPE：
  // EVENT_OPEN 开报名 / DEADLINE_24H / DEADLINE_72H / NEXT_YEAR 来年 /
  // CITY_CATEGORY_NEW 城市×品类新赛 / CITY_LAUNCH 城市开通
  type  String
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // 城市×品类订阅时使用
  city     String?
  category String?

  confirmed Boolean @default(false) // 是否已点击确认邮件（双重确认）
  confirmToken     String @unique
  unsubscribeToken String @unique
  notifiedAt DateTime? // 实际触达时间，防重复发送
  createdAt DateTime @default(now())

  @@unique([email, type, eventId, city, category])
}

// ---------- 用户投稿 / 报错 / 找赛需求（FR-06、FR-07）----------
model Submission {
  id      String @id @default(cuid())
  // EVENT_TIP 投稿 / CORRECTION 报错 / FIND_REQUEST 找赛需求
  type    String
  // 找赛需求/报错的定位信息
  city     String @default("")
  category String @default("")
  eventId  String?
  content  String // 用户填写的正文
  contact  String @default("")
  // PENDING / APPROVED / REJECTED
  status   String @default("PENDING")
  reviewNote String @default("")
  // 自动核对结果（FR-08 自我核对）：AUTO_PASS 高置信 / AUTO_REJECT 已过期 / NEED_HUMAN 需人工
  autoStatus String @default("")
  autoNote String @default("")
  autoCheckedAt DateTime?
  createdAt DateTime @default(now())
  reviewedAt DateTime?
}

// ---------- 品类空窗说明（城市 × 一级品类，FR-06）----------
model GapReason {
  id       String @id @default(cuid())
  city     String
  category String // 一级品类；“全部”表示城市级通用说明
  reason   String // 空窗原因
  seasonNote String @default("") // 往年档期规律
  updatedAt DateTime @updatedAt

  @@unique([city, category])
}

// ---------- 社区用户（爱好者 / 球馆，邮箱+密码注册）----------
model User {
  id    String @id @default(cuid())
  email String @unique // 登录标识（小写）
  passwordHash String // scrypt 哈希（salt 拼接存储，见 src/lib/password.ts）
  name  String // 昵称（展示用）
  bio   String @default("") // 个人简介（用户主页展示）
  avatar String @default("") // 头像图片路径（public/uploads 下相对路径，空=默认头像）

  createdAt DateTime @default(now())

  // 关联
  sessions   Session[]
  venueProfile VenueProfile?
  posts      Post[]
  comments   Comment[]
  likes      Like[]
  // 关注关系（单向）：我关注的人 / 关注我的人
  following  Follow[] @relation("follower")
  followers  Follow[] @relation("following")
  submittedEvents Event[] // 该用户（球馆）提交的赛事
  // 站内通知：我收到的 / 我触发的
  notifications Notification[] @relation("notificationOwner")
  notifiedActions Notification[] @relation("notificationActor")
  // 评论回复目标（我回复了谁的哪些评论）
  repliedComments Comment[] @relation("commentReplyTo")
  // 私信：我发出的 / 我收到的
  sentMessages     Message[] @relation("messageSender")
  receivedMessages Message[] @relation("messageReceiver")
}

// ---------- 登录会话（httpOnly cookie → session token）----------
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  token  String @unique // 随机 48 位 hex，cookie 存储
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- 球馆资料 / 认证申请 ----------
model VenueProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueName String // 球馆名称
  city    String
  address String @default("")
  phone   String @default("")
  intro   String @default("") // 场馆介绍（场地数、设施等）
  // PENDING 待审核 / APPROVED 已认证（可发布赛事）/ REJECTED 已驳回
  status  String @default("PENDING")
  reviewNote String @default("")
  createdAt DateTime @default(now())
  reviewedAt DateTime?
}

// ---------- 社区帖子（作品）----------
model Post {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String @default("") // 标题（可空，随笔类）
  content String // 正文
  images String @default("[]") // 图片路径 JSON 数组（public/uploads 相对路径）
  // 话题标签：取值见 src/lib/constants.ts 的 TOPICS（空 = 未分类随笔）
  topic String @default("")
  // 关联赛事：赛事讨论区（赛事详情页展示关联帖；赛事删除后置空不删帖）
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  likeCount    Int @default(0) // 点赞数（冗余计数，展示用）
  commentCount Int @default(0) // 评论数（冗余计数，展示用）
  createdAt DateTime @default(now())

  comments Comment[]
  likes    Like[]

  @@index([createdAt])
  @@index([userId])
  @@index([eventId])
}

// ---------- 帖子评论 ----------
model Comment {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  content String
  // 盖楼回复：回复目标评论的作者（null = 直接评论帖主，不指向某条评论）
  replyToUserId String?
  replyTo       User?   @relation("commentReplyTo", fields: [replyToUserId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([postId])
}

// ---------- 私信（点对点，无会话表：按 (min,max) 双方 ID 在查询层聚合会话）----------
model Message {
  id     String @id @default(cuid())
  senderId String
  sender   User @relation("messageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User @relation("messageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  content String // 500 字内
  read   Boolean @default(false) // 接收方是否已读
  createdAt DateTime @default(now())

  @@index([receiverId, read])
  @@index([senderId])
}

// ---------- 帖子点赞（一人一帖最多一赞）----------
model Like {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

// ---------- 站内通知（被关注/被评论/被点赞）----------
model Notification {
  id     String @id @default(cuid())
  userId String // 接收者
  user   User   @relation("notificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  actorId String // 触发者（谁关注/评论/赞了你）
  actor  User   @relation("notificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  // FOLLOW 关注 / COMMENT 评论 / LIKE 点赞
  type   String
  postId String? // 评论/点赞关联的帖子（关注类为 null）
  read   Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

// ---------- 单向关注（微博式：关注即看动态，无需对方同意）----------
model Follow {
  id String @id @default(cuid())
  // follower 关注了 following
  followerId  String
  follower    User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}
